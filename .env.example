# Αντιγράψτε αυτό το αρχείο σε .env και συμπληρώστε τα στοιχεία σας

# Θύρα στην οποία θα «ακούει» η εφαρμογή
PORT=3000

# Μυστικό κλειδί για την κρυπτογράφηση των sessions (βάλτε μια τυχαία τιμή)
SESSION_SECRET=change-this-to-a-random-secret

# Στοιχεία αρχικού λογαριασμού διαχειριστή (χρησιμοποιούνται μόνο από το npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@example.com
ADMIN_FULLNAME=Διαχειριστής

# Ρυθμίσεις SMTP για την αποστολή email ειδοποιήσεων
# Παράδειγμα για Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# Για Gmail χρειάζεται "App Password", όχι ο κανονικός κωδικός του λογαριασμού
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Το όνομα/email αποστολέα που θα εμφανίζεται στα email
MAIL_FROM="Equipment Manager <your-email@gmail.com>"

# Το email που θα λαμβάνει τις ειδοποιήσεις χρέωσης/αποχρέωσης
NOTIFY_EMAIL=manthoulahlepa@gmail.com
