# Αντιγράψτε αυτό το αρχείο σε .env και συμπληρώστε τα στοιχεία σας

# Θύρα στην οποία θα «ακούει» η εφαρμογή
PORT=3000

# Μυστικό κλειδί για την κρυπτογράφηση των sessions (βάλτε μια τυχαία τιμή)
SESSION_SECRET=change-this-to-a-random-secret

# Στοιχεία αρχικού λογαριασμού διαχειριστή (χρησιμοποιούνται μόνο από το npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@example.com
ADMIN_FULLNAME=Διαχειριστής

# Αποστολή email μέσω του HTTPS API της Resend (https://resend.com) — δωρεάν πλάνο.
# Φτιάξτε λογαριασμό, πηγαίνετε στο "API Keys" και δημιουργήστε ένα κλειδί.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Το όνομα/email αποστολέα που θα εμφανίζεται στα email.
# Χωρίς επιβεβαιωμένο δικό σας domain στη Resend, πρέπει να μείνει το onboarding@resend.dev
# (και το NOTIFY_EMAIL πρέπει να είναι το ίδιο email με αυτό που κάνατε εγγραφή στη Resend).
MAIL_FROM="Equipment Manager <onboarding@resend.dev>"

# Το email που θα λαμβάνει τις ειδοποιήσεις χρέωσης/αποχρέωσης
NOTIFY_EMAIL=manthoulahlepa@gmail.com
