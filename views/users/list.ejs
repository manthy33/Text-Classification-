<%- include('../partials/header') %>
<h1>Χρήστες</h1>
<div class="actions">
  <a href="/users/new" class="btn">Νέος χρήστης</a>
</div>
<table>
  <thead>
    <tr>
      <th>Όνομα</th>
      <th>Username</th>
      <th>Email</th>
      <th>Ρόλος</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(function(u) { %>
    <tr>
      <td><%= u.full_name %></td>
      <td><%= u.username %></td>
      <td><%= u.email %></td>
      <td><%= u.role === 'admin' ? 'Διαχειριστής' : 'Τεχνικός' %></td>
      <td>
        <% if (u.id !== currentUser.id) { %>
        <form class="inline" method="post" action="/users/<%= u.id %>/delete" onsubmit="return confirm('Διαγραφή χρήστη;');">
          <button type="submit" class="link-button">Διαγραφή</button>
        </form>
        <% } %>
      </td>
    </tr>
    <% }); %>
  </tbody>
</table>
<%- include('../partials/footer') %>
